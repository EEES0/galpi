# Render Web Service
# Base64-encoded cryptographically random key of at least 32 bytes; keep stable across restarts.
VISITOR_JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_RENDER_INTERNAL_HOST:5432/YOUR_DATABASE?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# Local compose only
POSTGRES_DB=galpi
POSTGRES_USER=galpi
POSTGRES_PASSWORD=
APP_PORT=8080
